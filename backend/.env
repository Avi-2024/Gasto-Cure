# ClinixPulse™ Multi-Tenant SaaS Backend Environment Configuration

# App
NODE_ENV=development
PORT=8080
APP_NAME=ClinixPulse-API
API_BASE_URL=http://localhost:8080

# -------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE CONNECTIONS
# -------------------------------------------------------------
# In your Supabase Project: Go to Project Settings -> Database -> Connection string
# 1. DATABASE_URL: Connection Pooling (Transaction Mode, Port 6543) for runtime queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct Connection (Session Mode, Port 5432) for Prisma db push & migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# -------------------------------------------------------------
# SUPABASE STORAGE & CLIENT (No AWS Needed)
# -------------------------------------------------------------
# In Supabase: Project Settings -> API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="clinic-assets"

# -------------------------------------------------------------
# JWT AUTHENTICATION
# -------------------------------------------------------------
JWT_ACCESS_SECRET="clinixpulse_jwt_access_super_secret_dev_key_2026"
JWT_REFRESH_SECRET="clinixpulse_jwt_refresh_super_secret_dev_key_2026"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="30d"

# -------------------------------------------------------------
# CORS & NETWORKING
# -------------------------------------------------------------
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
LOG_LEVEL=debug
